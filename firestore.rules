rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only phone-authenticated users may touch any data (blocks leftover email accounts).
    function phoneUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'phone';
    }
    function isSelf(uid) { return phoneUser() && request.auth.uid == uid; }

    // Profile: owner-only. No directory; lookup is done by the Cloud Function (Admin SDK).
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'phoneNumber', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      // Private contact names: only the owner can read or write.
      match /contacts/{contactUid} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && contactUid != uid
          && request.resource.data.keys().hasOnly(['contactUid', 'phoneNumber', 'name', 'updatedAt'])
          && request.resource.data.contactUid == contactUid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 40
          && request.resource.data.phoneNumber == get(/databases/$(database)/documents/users/$(contactUid)).data.phoneNumber
          && request.resource.data.updatedAt == request.time;
        allow delete: if isSelf(uid);
      }
    }

    // Used only by the Cloud Function (Admin SDK bypasses rules). No client access.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Conversation ID = sorted participant UIDs joined by "_" (one conversation per pair).
    match /conversations/{conversationId} {
      allow get: if phoneUser() && (
        resource == null
          ? request.auth.uid in conversationId.split('_')
          : request.auth.uid in resource.data.participants);

      allow list: if phoneUser() && request.auth.uid in resource.data.participants;

      allow create: if phoneUser()
        && request.resource.data.keys().hasOnly(['participants', 'participantPhones', 'createdAt', 'updatedAt', 'lastMessageText', 'lastSenderId'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && conversationId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.participantPhones.size() == 2
        && request.resource.data.participantPhones[request.resource.data.participants[0]]
             == get(/databases/$(database)/documents/users/$(request.resource.data.participants[0])).data.phoneNumber
        && request.resource.data.participantPhones[request.resource.data.participants[1]]
             == get(/databases/$(database)/documents/users/$(request.resource.data.participants[1])).data.phoneNumber
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageText == ''
        && request.resource.data.lastSenderId == null;

      // Participants may only change last-message metadata; membership is immutable.
      allow update: if phoneUser() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessageText', 'lastSenderId'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 100;

      allow delete: if false;

      match /messages/{messageId} {
        function conv() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if phoneUser() && request.auth.uid in conv().participants;

        allow create: if phoneUser() && request.auth.uid in conv().participants
          && request.resource.data.keys().hasOnly(['conversationId', 'senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.conversationId == conversationId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
