rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Public directory: only uid, displayName, searchName, createdAt. No emails.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'searchName', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.searchName == request.resource.data.displayName.lower()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      // Private account data (owner only).
      match /private/{docId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && docId == 'account'
          && request.resource.data.keys().hasOnly(['email'])
          && (request.resource.data.email == null || request.resource.data.email is string);
        allow update, delete: if false;
      }
    }

    // Conversation ID = sorted participant UIDs joined by "_" (one conversation per pair).
    match /conversations/{conversationId} {
      allow get: if signedIn() && (
        resource == null
          ? request.auth.uid in conversationId.split('_')
          : request.auth.uid in resource.data.participants);

      allow list: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'participantNames', 'createdAt', 'updatedAt', 'lastMessageText', 'lastSenderId'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && conversationId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.participantNames.size() == 2
        && request.resource.data.participantNames[request.resource.data.participants[0]]
             == get(/databases/$(database)/documents/users/$(request.resource.data.participants[0])).data.displayName
        && request.resource.data.participantNames[request.resource.data.participants[1]]
             == get(/databases/$(database)/documents/users/$(request.resource.data.participants[1])).data.displayName
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageText == ''
        && request.resource.data.lastSenderId == null;

      // Participants may only change last-message metadata; membership is immutable.
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessageText', 'lastSenderId'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 100;

      allow delete: if false;

      match /messages/{messageId} {
        function conv() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if signedIn() && request.auth.uid in conv().participants;

        allow create: if signedIn() && request.auth.uid in conv().participants
          && request.resource.data.keys().hasOnly(['conversationId', 'senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.conversationId == conversationId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
